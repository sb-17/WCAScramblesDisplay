# Register an OAuth application at https://www.worldcubeassociation.org/oauth/applications
#
# Redirect URIs must be listed there exactly. Add both, one per line:
#   http://localhost:3000/api/auth/callback
#   https://<your-deployment>/api/auth/callback
#
# Scope: public
WCA_CLIENT_ID=
WCA_CLIENT_SECRET=

# Neon connection string, from the project dashboard. Use the pooled URL.
# Then apply the schema with:  npm run migrate
DATABASE_URL=

# Signs the session cookie. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
