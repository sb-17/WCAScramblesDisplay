{
  "name": "wca-scrambles-display",
  "private": true,
  "type": "module",
  "scripts": {
    "parse": "tsx src/scrambles/cli.ts",
    "selftest": "npm run selftest:zip && npm run selftest:crypto",
    "typecheck": "tsc --noEmit",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "selftest:zip": "tsx src/scrambles/selftest.ts",
    "selftest:crypto": "tsx src/lib/crypto.selftest.ts",
    "migrate": "tsx --env-file=.env.local src/db/migrate.ts",
    "dev:https": "next dev --experimental-https",
    "predev": "node scripts/copy-pdf-worker.mjs",
    "predev:https": "node scripts/copy-pdf-worker.mjs",
    "prebuild": "node scripts/copy-pdf-worker.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@zip.js/zip.js": "^2.8.51",
    "jose": "^6.2.9",
    "next": "^16.3.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
